{
  "manifest_version": 3,
  "name": "SpellSheet",
  "version": "0.1.0",
  "description": "Lets SpellSheet flows work in this Edge, with your own sign-ins. SpellSheet のフローが、ふだんのサインインのままこの Edge で動けるようにします。",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "32": "icon-32.png", "128": "icon-128.png" },
  "key": ""
}
