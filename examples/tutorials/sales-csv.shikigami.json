{
  "format": "shikigami.flowBundle",
  "formatVersion": 2,
  "exportedAt": "2026-11-06T00:00:00Z",
  "flow": {
    "schemaVersion": 1,
    "id": "scn_tutorial_sales_csv",
    "name": "支店の売上 CSV を 1 つの Excel にまとめる",
    "description": "input にある支店ごとの売上 CSV を読み、明細と支店別の合計を output/売上まとめ.xlsx に書く。チュートリアル（docs/ja/tutorials/sales-csv.md）の完成形。",
    "revision": 1,
    "metadata": {
      "tags": [
        "チュートリアル"
      ]
    },
    "variables": [
      {
        "name": "folder",
        "type": "string",
        "direction": "input",
        "default": "input",
        "description": "支店ごとの売上 CSV があるフォルダー"
      },
      {
        "name": "outFile",
        "type": "string",
        "direction": "input",
        "default": "output/売上まとめ.xlsx",
        "description": "書き出す Excel"
      },
      {
        "name": "branchCount",
        "type": "number",
        "direction": "output",
        "default": 0,
        "description": "読んだ支店の数"
      },
      {
        "name": "grandTotal",
        "type": "number",
        "direction": "output",
        "default": 0,
        "description": "全支店の売上合計（円）"
      },
      {
        "name": "files",
        "type": "array",
        "default": []
      },
      {
        "name": "rows",
        "type": "array",
        "default": []
      },
      {
        "name": "all",
        "type": "array",
        "default": []
      },
      {
        "name": "totals",
        "type": "array",
        "default": []
      }
    ],
    "steps": [
      {
        "id": "stp_list",
        "type": "file.list",
        "name": "CSV の一覧",
        "params": {
          "folder": "{{ folder }}",
          "pattern": "*.csv"
        },
        "saveAs": "files"
      },
      {
        "id": "stp_each",
        "type": "control.forEach",
        "name": "支店ごとに読む",
        "params": {
          "items": "files",
          "itemVar": "file"
        },
        "blocks": {
          "body": [
            {
              "id": "stp_read",
              "type": "file.readCsv",
              "name": "CSV を読む",
              "params": {
                "path": "{{ file.path }}"
              },
              "saveAs": "rows"
            },
            {
              "id": "stp_add",
              "type": "variable.set",
              "name": "支店名を付けて足す",
              "params": {
                "name": "all",
                "expression": "all + map(rows, r => { '支店': baseName(file.name), '日付': r['日付'], '商品': r['商品'], '数量': num(r['数量']), '金額': num(r['金額']) })"
              }
            }
          ]
        }
      },
      {
        "id": "stp_totals",
        "type": "variable.set",
        "name": "支店別の合計",
        "params": {
          "name": "totals",
          "expression": "map(sort(keys(groupBy(all, r => r['支店']))), b => { '支店': b, '件数': len(filter(all, r => r['支店'] == b)), '金額': sum(map(filter(all, r => r['支店'] == b), r => r['金額'])) })"
        }
      },
      {
        "id": "stp_clear",
        "type": "file.delete",
        "name": "前回の Excel を消す",
        "params": {
          "path": "{{ outFile }}"
        }
      },
      {
        "id": "stp_folder",
        "type": "file.createFolder",
        "name": "出力先のフォルダー",
        "params": {
          "path": "{{ dirName(outFile) }}"
        }
      },
      {
        "id": "stp_sheet1",
        "type": "excel.addSheet",
        "name": "明細のシート",
        "params": {
          "path": "{{ outFile }}",
          "sheet": "明細"
        }
      },
      {
        "id": "stp_detail",
        "type": "excel.appendRows",
        "name": "明細を書く",
        "params": {
          "path": "{{ outFile }}",
          "sheet": "明細",
          "rows": "{{ all }}"
        }
      },
      {
        "id": "stp_sheet2",
        "type": "excel.addSheet",
        "name": "支店別のシート",
        "params": {
          "path": "{{ outFile }}",
          "sheet": "支店別"
        }
      },
      {
        "id": "stp_total",
        "type": "excel.appendRows",
        "name": "支店別の合計を書く",
        "params": {
          "path": "{{ outFile }}",
          "sheet": "支店別",
          "rows": "{{ totals }}"
        }
      },
      {
        "id": "stp_count",
        "type": "variable.set",
        "name": "支店の数",
        "params": {
          "name": "branchCount",
          "expression": "len(totals)"
        }
      },
      {
        "id": "stp_sum",
        "type": "variable.set",
        "name": "全体の合計",
        "params": {
          "name": "grandTotal",
          "expression": "sum(map(totals, t => t['金額']))"
        }
      },
      {
        "id": "stp_done",
        "type": "log.message",
        "name": "結果",
        "params": {
          "message": "{{ branchCount }} 支店・{{ len(all) }} 行、合計 {{ formatNumber(grandTotal) }} 円を {{ outFile }} に書きました"
        }
      }
    ]
  },
