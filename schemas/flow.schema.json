{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow",
  "description": "A flow: the unit that AI clients, Studio and the Runtime share.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Optional JSON Schema reference for editors. Ignored by Shikigami.",
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "description": "Version of the flow file format.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "id": {
      "$ref": "#/$defs/FlowId"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "description": "Plugins the steps need, with the versions they were written for:\n`{ \"plugin:kintone\": \"^0.3.1\" }`. Kept up to date by Core when steps\nare added or removed, so authors normally leave it alone.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "revision": {
      "description": "Monotonic revision, incremented by every committed edit. Used for\noptimistic concurrency between Studio, MCP clients and the CLI.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "default": 0
    },
    "variables": {
      "description": "Declared variables (inputs, outputs and locals).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/VariableDef"
      }
    },
    "parts": {
      "description": "Named screen parts (a button, a field…): a node's `target` can be\n`{ \"part\": \"<name>\" }` instead of the whole target, so a part that\nchanges is fixed in one place. Keys are like variable names.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Part"
      }
    },
    "steps": {
      "description": "Top-level steps, executed in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "default": []
    },
    "settings": {
      "description": "Flow-wide defaults for error handling, timeouts and retries.",
      "$ref": "#/$defs/FlowSettings"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata",
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name"
  ],
  "$defs": {
    "FlowId": {
      "description": "Identifier of a flow. Also used as its file name in the store.",
      "type": "string"
    },
    "VariableDef": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Identifier used in expressions: `[A-Za-z_][A-Za-z0-9_]*`.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/VarType",
          "default": "any"
        },
        "direction": {
          "$ref": "#/$defs/VarDirection",
          "default": "local"
        },
        "default": true,
        "description": {
          "type": "string"
        },
        "secret": {
          "description": "Secret values are masked in logs, events and run records.",
          "type": "boolean"
        },
        "format": {
          "description": "What a `string` input holds, so the run window can offer the right\nfield (a file picker, a calendar). Runs do not check it.",
          "anyOf": [
            {
              "$ref": "#/$defs/VarFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "choices": {
          "description": "The only values an input takes: the run window shows a list to pick\nfrom. Each one must match `type`.",
          "type": "array",
          "items": true
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "VarType": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "any"
      ]
    },
    "VarDirection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "local"
          ]
        },
        {
          "description": "Supplied by the caller when the run starts.",
          "type": "string",
          "const": "input"
        },
        {
          "description": "Returned to the caller when the run finishes.",
          "type": "string",
          "const": "output"
        },
        {
          "description": "Both supplied and returned.",
          "type": "string",
          "const": "inOut"
        }
      ]
    },
    "VarFormat": {
      "description": "What a text variable holds ([`VariableDef::format`]).",
      "oneOf": [
        {
          "description": "The full path of an existing file.",
          "type": "string",
          "const": "file"
        },
        {
          "description": "The full path of a folder.",
          "type": "string",
          "const": "folder"
        },
        {
          "description": "A day, `YYYY-MM-DD`.",
          "type": "string",
          "const": "date"
        },
        {
          "description": "A month, `YYYY-MM`.",
          "type": "string",
          "const": "month"
        }
      ]
    },
    "Part": {
      "description": "A named screen part: what a node finds on screen, kept in one place.",
      "type": "object",
      "properties": {
        "label": {
          "description": "What people call it (保存ボタン). The key is for nodes and AI.",
          "type": "string"
        },
        "app": {
          "description": "The kind of node that can use it.",
          "$ref": "#/$defs/PartApp"
        },
        "target": {
          "description": "The target, exactly as the nodes of `app` take it."
        }
      },
      "additionalProperties": false,
      "required": [
        "app",
        "target"
      ]
    },
    "PartApp": {
      "type": "string",
      "enum": [
        "browser",
        "desktop"
      ]
    },
    "Step": {
      "description": "A single step. Control-flow and action steps share this shape.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable unique ID. Omit when adding a step; Core assigns one.",
          "$ref": "#/$defs/StepId"
        },
        "type": {
          "description": "Step type, e.g. `control.if`, `variable.set`, `browser.click`.",
          "type": "string"
        },
        "name": {
          "description": "Display label (Japanese is fine). Purely informational.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "params": {
          "description": "Type-specific parameters, validated against the step type's schema.\nString values may contain `{{ expression }}` templates.",
          "type": "object",
          "additionalProperties": true
        },
        "blocks": {
          "description": "Child step lists of control-flow steps, keyed by block name.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Step"
            }
          }
        },
        "disabled": {
          "description": "Disabled steps are skipped by the Runtime but kept in the flow.",
          "type": "boolean"
        },
        "timeoutMs": {
          "description": "Per-attempt timeout. Falls back to `settings.defaultTimeoutMs`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "onError": {
          "description": "What to do when the step still fails after retries.",
          "anyOf": [
            {
              "$ref": "#/$defs/OnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "saveAs": {
          "description": "Variable that receives the step's output value.",
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "description": "Free-form metadata (Studio layout hints, AI provenance such as the UI\nelement a selector was derived from). Never interpreted by the Runtime.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "StepId": {
      "description": "Identifier of a step. Unique within a flow and stable across edits.",
      "type": "string"
    },
    "RetryPolicy": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "description": "Total attempts including the first one (1 = no retry).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "backoffMs": {
          "description": "Delay before the second attempt.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 1000
        },
        "backoffMultiplier": {
          "description": "Multiplier applied to the delay after each failed attempt.",
          "type": "number",
          "format": "double",
          "default": 2.0
        }
      },
      "additionalProperties": false,
      "required": [
        "maxAttempts"
      ]
    },
    "OnError": {
      "oneOf": [
        {
          "description": "Stop the run (or hand control to the enclosing `control.try`).",
          "type": "string",
          "const": "fail"
        },
        {
          "description": "Record the error in `lastError` and continue with the next step.",
          "type": "string",
          "const": "continue"
        }
      ]
    },
    "FlowSettings": {
      "type": "object",
      "properties": {
        "defaultTimeoutMs": {
          "description": "Default per-step timeout in milliseconds (30 s when omitted).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "defaultRetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "onError": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "keepWork": {
          "description": "Leave the files in the flow's `work/` folder when a run starts.\nBy default a run starts with `work/` emptied.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$id": "https://shikigami.dev/schemas/flow.schema.json"
}
