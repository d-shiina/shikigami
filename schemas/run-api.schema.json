{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShikigamiRunApi",
  "type": "object",
  "properties": {
    "run_event_envelope": {
      "$ref": "#/$defs/RunEventEnvelope"
    },
    "run_report": {
      "$ref": "#/$defs/RunReport"
    },
    "run_snapshot": {
      "$ref": "#/$defs/RunSnapshot"
    },
    "debug_command": {
      "$ref": "#/$defs/DebugCommand"
    },
    "case_result": {
      "$ref": "#/$defs/CaseResult"
    }
  },
  "required": [
    "run_event_envelope",
    "run_report",
    "run_snapshot",
    "debug_command",
    "case_result"
  ],
  "$defs": {
    "RunEventEnvelope": {
      "description": "A run event with ordering and timing metadata.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "description": "Monotonic sequence number within the run, starting at 0.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "at": {
          "type": "string"
        },
        "callPath": {
          "description": "The `flow.call` steps (outermost first) the event happened\ninside; empty for the flow that was started. Step IDs in the\nevent belong to the innermost called flow.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepId"
          }
        }
      },
      "required": [
        "runId",
        "seq",
        "at"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runStarted"
            },
            "flowId": {
              "$ref": "#/$defs/FlowId"
            },
            "flowName": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "origin": {
              "description": "Who asked for the run, from where, on which PC.",
              "$ref": "#/$defs/RunOrigin"
            }
          },
          "required": [
            "type",
            "flowId",
            "flowName",
            "revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stepStarted"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "stepType": {
              "type": "string"
            },
            "attempt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "stepId",
            "stepType",
            "attempt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stepFinished"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "stepType": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/StepOutcome"
            },
            "durationMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "willRetry": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "stepId",
            "stepType",
            "outcome",
            "durationMs"
          ]
        },
        {
          "description": "A variable was assigned: by `variable.set`, a step's `saveAs`, a\nloop's item/index variable, `errorVar` / `lastError`, or (without\n`stepId`) its input or default value when the run starts. Changes a\nparallel branch makes are reported when the branch makes them, not\nagain when they are merged back.\n\n`value` is the new value: `\"***\"` for secret variables, other\nsecrets masked inside it, and cut to a preview when large (see\n`truncated`).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variableChanged"
            },
            "variable": {
              "type": "string"
            },
            "value": true,
            "stepId": {
              "description": "The step that assigned it; absent for inputs and defaults.",
              "anyOf": [
                {
                  "$ref": "#/$defs/StepId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "iteration": {
              "description": "Item index (from 0) of the concurrent `forEach` iteration that\nmade the change, so interleaved iterations can be told apart.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "secret": {
              "type": "boolean"
            },
            "truncated": {
              "description": "`value` is a preview: a long string cut short, or the start of\na large array / object's JSON text.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "variable",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "log"
            },
            "level": {
              "$ref": "#/$defs/LogLevel"
            },
            "message": {
              "type": "string"
            },
            "stepId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StepId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "level",
            "message"
          ]
        },
        {
          "description": "A step waits for a person (e.g. to log in or approve MFA on the\nscreen). Studio shows `message` until the step finishes.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "humanActionRequired"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "stepId",
            "message"
          ]
        },
        {
          "description": "An interactive run stopped before `stepId` (breakpoint, step\ncommand, pause request) or after it failed (`reason: \"error\"`, with\n`error`). Nothing runs until it is resumed.\n\n`variables` holds every variable's value at that point, masked and\ncut like `variableChanged` values. `revision` is the flow\nrevision the run is executing.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paused"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "stepType": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/PauseReason"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "variables": {
              "type": "object",
              "additionalProperties": true
            },
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "stepId",
            "stepType",
            "reason",
            "variables",
            "revision"
          ]
        },
        {
          "description": "The run goes on after `paused`. `revision` is set when a newer\nrevision of the flow was swapped in while it was paused.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "resumed"
            },
            "action": {
              "$ref": "#/$defs/ResumeAction"
            },
            "revision": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runFinished"
            },
            "status": {
              "$ref": "#/$defs/RunStatus"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "status",
            "durationMs"
          ]
        }
      ]
    },
    "RunId": {
      "description": "Identifier of a single flow execution.",
      "type": "string"
    },
    "StepId": {
      "description": "Identifier of a step. Unique within a flow and stable across edits.",
      "type": "string"
    },
    "FlowId": {
      "description": "Identifier of a flow. Also used as its file name in the store.",
      "type": "string"
    },
    "RunOrigin": {
      "description": "Who asked for a run, from where, and on which PC. Recorded in\n`runStarted` and the report so that runs can be told apart later (and\ncollected from many PCs).",
      "type": "object",
      "properties": {
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunTrigger"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedBy": {
          "description": "The person, AI client, schedule or manager that asked, in its own\nwords (e.g. \"claude-code\", a schedule's name).",
          "type": [
            "string",
            "null"
          ]
        },
        "jobId": {
          "description": "The job of a schedule or management server this run carries out.",
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "description": "The PC the run happened on (its computer name). Filled in by the\nRuntime when not given.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RunTrigger": {
      "description": "How a run was started.",
      "oneOf": [
        {
          "description": "\"Run\" in Studio (a person watching).",
          "type": "string",
          "const": "studio"
        },
        {
          "description": "An AI client's `run_flow` / `test_step`.",
          "type": "string",
          "const": "mcp"
        },
        {
          "description": "`shikigami run` (a person, a batch file or Task Scheduler).",
          "type": "string",
          "const": "cli"
        },
        {
          "description": "A schedule of the agent.",
          "type": "string",
          "const": "schedule"
        },
        {
          "description": "A job from a management server.",
          "type": "string",
          "const": "remote"
        }
      ]
    },
    "StepOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "RunError": {
      "description": "Structured failure information, kept for AI-assisted diagnosis.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable code, e.g. `STEP_TIMEOUT`, `EXPR_UNDEFINED_VARIABLE`, `ELEMENT_NOT_FOUND`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stepId": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepType": {
          "type": [
            "string",
            "null"
          ]
        },
        "stepLabel": {
          "description": "The node as people know it: its name, else its type's label. Set on\nthe run's final error (report, notifications), so the place can be\ntold without the flow at hand; `stepId` stays the key to the node.",
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Adapter-specific evidence: UI element snapshot, screenshot path,\nexpected vs. actual state, etc."
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "LogLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "PauseReason": {
      "description": "Why a run paused.",
      "oneOf": [
        {
          "description": "Before a step with a breakpoint.",
          "type": "string",
          "const": "breakpoint"
        },
        {
          "description": "Before the next step after a step command or at the start.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "Before the next step after [`DebugCommand::Pause`].",
          "type": "string",
          "const": "requested"
        },
        {
          "description": "After the step failed (`error` says why); it has not been handled.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "ResumeAction": {
      "description": "What a resumed run does next (reported as `resumed`).",
      "type": "string",
      "enum": [
        "continue",
        "stepOver",
        "stepInto",
        "stepOut",
        "retry",
        "skip",
        "abort"
      ]
    },
    "RunStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "An interactive run waits for a person (see `paused`).",
          "type": "string",
          "const": "paused"
        }
      ]
    },
    "RunReport": {
      "description": "Final result of a run.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "flowId": {
          "$ref": "#/$defs/FlowId"
        },
        "flowName": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "description": "Named version whose content was run, when it matches one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "description": "Values of output variables (secret outputs are masked when recorded).",
          "type": "object",
          "additionalProperties": true
        },
        "subflows": {
          "description": "The flows `flow.call` steps could run, as they were when the\nrun started.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubflowRef"
          }
        },
        "origin": {
          "description": "Who asked for the run, from where, on which PC.",
          "$ref": "#/$defs/RunOrigin"
        },
        "secretsUsed": {
          "description": "Names of the secrets the run used (typed values, API auth, saved\nlogins, OAuth tokens), never their values.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runId",
        "flowId",
        "flowName",
        "revision",
        "status",
        "startedAt",
        "finishedAt",
        "outputs"
      ]
    },
    "SubflowRef": {
      "description": "A called flow's content as used by a run.",
      "type": "object",
      "properties": {
        "flowId": {
          "$ref": "#/$defs/FlowId"
        },
        "flowName": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "description": "Named version its content matches, if any.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "flowId",
        "flowName",
        "revision"
      ]
    },
    "RunSnapshot": {
      "description": "Live state of a run, for `get_run_status` while it is executing.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "flowId": {
          "$ref": "#/$defs/FlowId"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "currentStep": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepsExecuted": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "runId",
        "flowId",
        "status",
        "stepsExecuted"
      ]
    },
    "DebugCommand": {
      "description": "What a person does with a run (see [`DebugControl::send`]).",
      "oneOf": [
        {
          "description": "Run until the next breakpoint or unhandled error. Paused on an\nerror: run the failed step again first.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "continue"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "Run the step paused at, including everything inside it, and pause\nbefore the next one at the same level or above.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "stepOver"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "Pause before the very next step, inside blocks too.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "stepInto"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "Finish the block paused in and pause after it.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "stepOut"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "Paused on an error: run the failed step again, as it is now defined.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "retry"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "Leave the step paused at (or failed) undone and go on with the next.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "skip"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "End the run: as failed when paused on an error, otherwise as cancelled.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "abort"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "While running: pause before the next step.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "pause"
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "description": "Replace the breakpoints (any time).",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "setBreakpoints"
            },
            "stepIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StepId"
              }
            }
          },
          "required": [
            "action",
            "stepIds"
          ]
        },
        {
          "description": "While paused: give a variable another value before going on (the\nrun stays paused). Secret variables cannot be set this way; the\nchange is reported as `variableChanged` without a step.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "setVariable"
            },
            "name": {
              "type": "string"
            },
            "value": true
          },
          "required": [
            "action",
            "name",
            "value"
          ]
        }
      ]
    },
    "CaseResult": {
      "description": "One test case's run, compared with what it expects.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ]
        },
        "mismatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mismatch"
          }
        },
        "durationMs": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "name",
        "passed",
        "runId",
        "status",
        "mismatches",
        "durationMs"
      ]
    },
    "Mismatch": {
      "description": "One difference between what the case expects and what the run did.\n`actual` is `null` when the run had no such value.",
      "type": "object",
      "properties": {
        "at": {
          "description": "`status`, `outputs.total`, `outputs.rows[2].金額`, `errorCode`, `errorStep`.",
          "type": "string"
        },
        "expected": true,
        "actual": true
      },
      "required": [
        "at",
        "expected",
        "actual"
      ]
    }
  },
  "$id": "https://shikigami.dev/schemas/run-api.schema.json"
}
