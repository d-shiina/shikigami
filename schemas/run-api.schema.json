{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShikigamiRunApi",
  "type": "object",
  "properties": {
    "run_event_envelope": {
      "$ref": "#/$defs/RunEventEnvelope"
    },
    "run_report": {
      "$ref": "#/$defs/RunReport"
    },
    "run_snapshot": {
      "$ref": "#/$defs/RunSnapshot"
    }
  },
  "required": [
    "run_event_envelope",
    "run_report",
    "run_snapshot"
  ],
  "$defs": {
    "RunEventEnvelope": {
      "description": "A run event with ordering and timing metadata.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "description": "Monotonic sequence number within the run, starting at 0.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "seq",
        "at"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runStarted"
            },
            "scenarioId": {
              "$ref": "#/$defs/ScenarioId"
            },
            "scenarioName": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "scenarioId",
            "scenarioName",
            "revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stepStarted"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "stepType": {
              "type": "string"
            },
            "attempt": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "stepId",
            "stepType",
            "attempt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stepFinished"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "stepType": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/StepOutcome"
            },
            "durationMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "willRetry": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "stepId",
            "stepType",
            "outcome",
            "durationMs"
          ]
        },
        {
          "description": "A variable was assigned: by `variable.set`, a step's `saveAs`, a\nloop's item/index variable, `errorVar` / `lastError`, or (without\n`stepId`) its input or default value when the run starts. Changes a\nparallel branch makes are reported when the branch makes them, not\nagain when they are merged back.\n\n`value` is the new value: `\"***\"` for secret variables, other\nsecrets masked inside it, and cut to a preview when large (see\n`truncated`).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variableChanged"
            },
            "variable": {
              "type": "string"
            },
            "value": true,
            "stepId": {
              "description": "The step that assigned it; absent for inputs and defaults.",
              "anyOf": [
                {
                  "$ref": "#/$defs/StepId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "iteration": {
              "description": "Item index (from 0) of the concurrent `forEach` iteration that\nmade the change, so interleaved iterations can be told apart.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "secret": {
              "type": "boolean"
            },
            "truncated": {
              "description": "`value` is a preview: a long string cut short, or the start of\na large array / object's JSON text.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "variable",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "log"
            },
            "level": {
              "$ref": "#/$defs/LogLevel"
            },
            "message": {
              "type": "string"
            },
            "stepId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StepId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "level",
            "message"
          ]
        },
        {
          "description": "A step waits for a person (e.g. to log in or approve MFA on the\nscreen). Studio shows `message` until the step finishes.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "humanActionRequired"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "stepId",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runFinished"
            },
            "status": {
              "$ref": "#/$defs/RunStatus"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "status",
            "durationMs"
          ]
        }
      ]
    },
    "RunId": {
      "description": "Identifier of a single scenario execution.",
      "type": "string"
    },
    "ScenarioId": {
      "description": "Identifier of a scenario. Also used as its file name in the store.",
      "type": "string"
    },
    "StepId": {
      "description": "Identifier of a step. Unique within a scenario and stable across edits.",
      "type": "string"
    },
    "StepOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "RunError": {
      "description": "Structured failure information, kept for AI-assisted diagnosis.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable code, e.g. `STEP_TIMEOUT`, `EXPR_UNDEFINED_VARIABLE`, `ELEMENT_NOT_FOUND`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stepId": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepType": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Adapter-specific evidence: UI element snapshot, screenshot path,\nexpected vs. actual state, etc."
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "LogLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "RunReport": {
      "description": "Final result of a run.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "scenarioId": {
          "$ref": "#/$defs/ScenarioId"
        },
        "scenarioName": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "description": "Named version whose content was run, when it matches one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "description": "Values of output variables (secret outputs are masked when recorded).",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "runId",
        "scenarioId",
        "scenarioName",
        "revision",
        "status",
        "startedAt",
        "finishedAt",
        "outputs"
      ]
    },
    "RunSnapshot": {
      "description": "Live state of a run, for `get_run_status` while it is executing.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "scenarioId": {
          "$ref": "#/$defs/ScenarioId"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "currentStep": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepsExecuted": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "runId",
        "scenarioId",
        "status",
        "stepsExecuted"
      ]
    }
  },
  "$id": "https://shikigami.dev/schemas/run-api.schema.json"
}
